<resources>
    <!--
      Kept false on purpose. Commons gates a few features behind the "Fossify Thank You" app, and
      pretending it is installed looks like the easy way out, but it makes commons' customization
      screen save the theme through the shared global-settings provider - which needs a signature
      permission only the real Thank You app holds - so every save throws and the error toast
      reappears on each screen. The features this app needs are unlocked in code instead.
    -->
    <bool name="pretend_thank_you_installed">false</bool>
</resources>
