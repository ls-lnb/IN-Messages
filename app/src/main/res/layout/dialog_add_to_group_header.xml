<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/bigger_margin"
    android:paddingTop="@dimen/activity_margin"
    android:paddingEnd="@dimen/activity_margin">

    <org.fossify.commons.views.MyTextView
        android:id="@+id/add_to_group_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:fontFamily="sans-serif-light"
        android:includeFontPadding="false"
        android:text="@string/add_to_group"
        android:textSize="@dimen/actionbar_text_size"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/add_to_group_sort_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/normal_margin"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/small_margin"
        android:paddingTop="@dimen/small_margin"
        android:paddingEnd="@dimen/small_margin"
        android:paddingBottom="@dimen/small_margin">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/add_to_group_sort_icon"
            android:layout_width="@dimen/list_trailing_icon_size"
            android:layout_height="@dimen/list_trailing_icon_size"
            android:contentDescription="@null"
            android:src="@drawable/ic_sort_vector" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/add_to_group_sort_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/small_margin"
            android:includeFontPadding="false"
            android:textSize="@dimen/normal_text_size"
            tools:text="Recent" />

    </LinearLayout>

</LinearLayout>
